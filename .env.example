# Copy this file to .env and adjust values if needed.
# .env itself is git-ignored and never committed - this file is the template.

# Postgres credentials used by both docker-compose.yml and the backend
# to connect to the database. Defaults below work out of the box for local dev.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=expense_approval

# Secret key used to sign and verify JWT auth tokens.
# For real use (beyond local dev), generate a long random string instead
# of using this placeholder  e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=changeme-generate-a-random-secret-for-real-use